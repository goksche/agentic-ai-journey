# Passwort-Hash erzeugen: npm run hash-password   (oder per Docker, siehe DEPLOY.md)
CAMPUS_PASSWORD_HASH=
# Zufälliger Schlüssel für die Sitzungscookies (mind. 32 Zeichen): openssl rand -hex 32
CAMPUS_SESSION_SECRET=
# Lokal: Repo-Wurzel relativ zu platform/. In Docker auf /app/content gesetzt.
CONTENT_DIR=..
DATA_DIR=./data
# Nur auf dem Server: Domain, unter der die Plattform erreichbar ist (A-Record auf die Server-IP)
CAMPUS_DOMAIN=campus.example.ch
