# Adresse, an die der Login-Code geschickt wird
CAMPUS_LOGIN_EMAIL=
# Zufälliger Schlüssel für Sitzungscookies und Login-Codes (mind. 32 Zeichen): openssl rand -hex 32
CAMPUS_SESSION_SECRET=
# Mailversand für den Login-Code. Lokal leer lassen: Der Code erscheint dann in der Konsole.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Lokal: Repo-Wurzel relativ zu platform/. In Docker auf /app/content gesetzt.
CONTENT_DIR=..
DATA_DIR=./data
# Nur auf dem Server: Domain, unter der die Plattform erreichbar ist (A-Record auf die Server-IP)
CAMPUS_DOMAIN=campus.example.ch
